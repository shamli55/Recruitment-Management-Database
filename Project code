CREATE OR REPLACE VIEW JobOverview AS
SELECT
    j.JobID,
    j.JobTitle,
    c.CompanyName,
    j.JobLocation,
    j.EmploymentType,
    j.ExperienceRequired,
    j.Salary,
    j.Vacancy,
    j.PostedDate,
    j.LastDate
FROM Jobs j
JOIN Companies c
    ON j.CompanyID = c.CompanyID;

CREATE OR REPLACE VIEW RecruitmentDashboard AS
SELECT
    a.ApplicationID,
    CONCAT(c.FirstName, ' ', c.LastName) AS CandidateName,
    j.JobTitle,
    comp.CompanyName,
    a.ApplicationDate,
    a.Status
FROM Applications a
JOIN Candidates c
    ON a.CandidateID = c.CandidateID
JOIN Jobs j
    ON a.JobID = j.JobID
JOIN Companies comp
    ON j.CompanyID = comp.CompanyID;

SELECT * FROM RecruitmentDashboard;

SELECT
    c.CandidateID,
    CONCAT(c.FirstName, ' ', c.LastName) AS CandidateName,
    j.JobTitle,
    a.Status AS ApplicationStatus,
    i.InterviewType,
    i.InterviewStatus,
    f.TechnicalScore,
    f.CommunicationScore,
    f.OverallScore
FROM Candidates c
JOIN Applications a
    ON c.CandidateID = a.CandidateID
JOIN Jobs j
    ON a.JobID = j.JobID
JOIN Interviews i
    ON a.ApplicationID = i.ApplicationID
JOIN InterviewFeedback f
    ON i.InterviewID = f.InterviewID;

SELECT
    c.CandidateID,
    CONCAT(c.FirstName, ' ', c.LastName) AS CandidateName,
    AVG(f.OverallScore) AS AverageInterviewScore
FROM Candidates c
JOIN Applications a
    ON c.CandidateID = a.CandidateID
JOIN Interviews i
    ON a.ApplicationID = i.ApplicationID
JOIN InterviewFeedback f
    ON i.InterviewID = f.InterviewID
GROUP BY
    c.CandidateID,
    c.FirstName,
    c.LastName
ORDER BY AverageInterviewScore DESC
LIMIT 10;

